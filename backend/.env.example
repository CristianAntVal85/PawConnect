# ============================================
# PawConnect - Environment Configuration
# ============================================

APP_NAME=PawConnect
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

# ============================================
# DATABASE
# ============================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pawconnect
DB_USERNAME=pawconnect
DB_PASSWORD=pawconnect

# ============================================
# SECURITY - SANCTUM
# ============================================
# Dominios permitidos para autenticación stateful (SPA)
SANCTUM_STATEFUL_DOMAINS=localhost:8000,127.0.0.1:8000

# CORS para cliente móvil/web (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://10.0.2.2:3000,capacitor://localhost,ionic://localhost
# Patrones opcionales (regex), por ejemplo para previews o subdominios:
# CORS_ALLOWED_ORIGIN_PATTERNS=^https:\/\/([a-z0-9-]+\.)?pawconnect\.app$

# Expiración de tokens API en minutos (60 días = 87600)
# En producción considerar 30 días (43200) para mayor seguridad
SANCTUM_EXPIRATION=87600

# Prefijo de tokens (opcional, para escaneo de seguridad)
SANCTUM_TOKEN_PREFIX=

# ============================================
# SESSION & CACHE
# ============================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_DRIVER=database
CACHE_PREFIX=

# ============================================
# QUEUE
# ============================================
QUEUE_CONNECTION=database

# ============================================
# MAIL
# ============================================
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@pawconnect.com"
MAIL_FROM_NAME="${APP_NAME}"

# ============================================
# BROADCASTING - REVERB
# ============================================
BROADCAST_DRIVER=reverb

REVERB_APP_ID=pawconnect-app
REVERB_APP_KEY=local-reverb-key
REVERB_APP_SECRET=local-reverb-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ============================================
# FILESYSTEM
# ============================================
FILESYSTEM_DISK=public

# AWS S3 (si se usa en producción)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ============================================
# PAYMENTS - STRIPE
# ============================================
# Test keys (desarrollo)
STRIPE_KEY=pk_test_YOUR_TEST_KEY
STRIPE_SECRET=sk_test_YOUR_TEST_SECRET

# Live keys (producción - NO commitear)
# STRIPE_KEY=pk_live_YOUR_LIVE_KEY
# STRIPE_SECRET=sk_live_YOUR_LIVE_SECRET

# ============================================
# LOGGING
# ============================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null

# ============================================
# ADDITIONAL SERVICES
# ============================================
VITE_APP_NAME="${APP_NAME}"
